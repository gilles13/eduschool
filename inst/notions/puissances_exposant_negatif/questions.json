    {
      "id": "PUI-032",
      "type": "qcm",
      "enonce": "Dans l’égalité 5⁻² = 1 / 5², quel mot décrit la relation entre 5⁻² et 5² ? Choisis le mot à trou correspondant.",
      "presentation": {
        "type": "mot_a_trou",
        "masques": {
          "inverse": "i _ _ _ _ e",
          "opposé": "o _ _ _ é",
          "produit": "p _ _ _ _ t",
          "quotient": "q _ _ _ _ _ t"
        }
      },
      "reponse": {
        "mode": "editoriale",
        "valeur": "inverse"
      },
      "propositions": [
        "inverse",
        "opposé",
        "produit",
        "quotient"
      ],
      "correction": "5⁻² = 1 / 5² : une puissance d’exposant négatif s’écrit comme l’inverse de la puissance d’exposant positif correspondante."
    },
    {
      "id": "PUI-033",
      "type": "qcm",
      "enonce": "Quel nombre doit remplacer □ pour que 2^□ = 1/8 ?",
      "presentation": {
        "type": "boite"
      },
      "reponse": {
        "mode": "editoriale",
        "valeur": "−3"
      },
      "propositions": [
        "−3",
        "3",
        "−8",
        "1/3"
      ],
      "correction": "1/8 = 1 / 2³ = 2⁻³. La boîte vaut donc −3."
    },
    {
