      ],
      "correction": "Une puissance de puissance multiplie les exposants : 2 × 4 = 8."
    },
    {
      "id": "PUI-021",
      "type": "qcm",
      "enonce": "Pour a et b non nuls, quelle égalité est toujours vraie ?",
      "reponse": {
        "mode": "editoriale",
        "valeur": "(a / b)² = a² / b²"
      },
      "propositions": [
        "(a / b)² = a² / b²",
        "(a + b)² = a² + b²",
        "a² + a³ = a⁵",
        "a² / b² = a / b"
      ],
      "correction": "La puissance d’un quotient est le quotient des puissances lorsque le dénominateur est non nul."
    },
    {
      "id": "PUI-024",
      "type": "qcm",
      "enonce": "Quelle expression est égale à 8² ?",
      "reponse": {
