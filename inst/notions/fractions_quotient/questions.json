          "dividende": "d _ _ _ _ _ _ _ e"
        }
      },
      "reponse": {
        "mode": "editoriale",
        "valeur": "quotient"
      },
      "propositions": [
        "quotient",
        "produit",
        "diviseur",
        "dividende"
      ],
      "correction": "Le quotient est le résultat de la division ; le dividende est le nombre divisé et le diviseur celui par lequel on divise."
