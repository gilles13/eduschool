        "mode": "editoriale",
        "valeur": "500,27"
      },
      "propositions": [
        "500,27",
        "502,7",
        "500,207",
        "520,7"
      ],
      "correction": "Les deux derniers termes représentent deux dixièmes et sept centièmes."
    },
    {
      "id": "DECOMPOSITION_DECIMALE-003",
      "type": "qcm",
      "enonce": "Quelle écriture multiplicative correspond à 42,3 ?",
      "reponse": {
        "mode": "editoriale",
        "valeur": "4 × 10 + 2 × 1 + 3 × 0,1"
      },
      "propositions": [
        "4 × 10 + 2 × 1 + 3 × 0,1",
        "4 × 100 + 2 + 3 × 0,1",
        "4 × 10 + 2 + 3 × 0,01",
        "4 + 2 × 10 + 3 × 0,1"
      ],
      "correction": "La valeur dépend de la position de chaque chiffre."
    },
    {
      "id": "DECOMPOSITION_DECIMALE-004",
