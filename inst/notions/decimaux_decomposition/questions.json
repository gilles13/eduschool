      "id": "DECOMPOSITION_DECIMALE-001",
      "type": "qcm",
      "enonce": "Quelle somme est égale à 604,08 ?",
      "reponse": {
        "mode": "editoriale",
        "valeur": "600 + 4 + 0,08"
      },
      "propositions": [
        "600 + 4 + 0,08",
        "600 + 40 + 0,08",
        "600 + 4 + 0,8",
        "60 + 4 + 0,08"
      ],
      "correction": "Le zéro des dixièmes n’ajoute aucune valeur."
    },
    {
      "id": "DECOMPOSITION_DECIMALE-002",
