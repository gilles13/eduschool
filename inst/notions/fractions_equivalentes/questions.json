    {
      "id": "FRAC-VOCAB-001",
      "type": "qcm",
      "enonce": "Comment appelle-t-on le nombre situé au-dessus de la barre de fraction ? Choisis le mot masqué correspondant.",
      "presentation": {
        "type": "mot_masque",
        "avertissement": "La longueur du trait ne correspond pas au nombre de caractères du mot recherché.",
        "masques": {
          "numérateur": "N________R",
          "dénominateur": "DÉ________R",
          "quotient": "Q________T",
          "diviseur": "DI________R"
        }
      },
      "reponse": "numérateur",
      "propositions": [
        "numérateur",
        "dénominateur",
        "quotient",
        "diviseur"
      ],
      "correction": "Le numérateur indique combien de parts sont considérées. Le dénominateur précise en combien de parts égales l’unité est divisée."
    },
    {
      "id": "FRAC-VOCAB-DENOMINATEUR-001",
      "type": "qcm",
      "enonce": "Comment appelle-t-on le nombre situé sous la barre de fraction ? Choisis le mot à trou correspondant.",
      "presentation": {
        "type": "mot_a_trou",
        "masques": {
          "dénominateur": "d é _ _ _ _ _ _ _ _ _ r",
          "numérateur": "n u _ _ _ _ _ _ _ r",
          "quotient": "q u _ _ _ _ _ t",
          "diviseur": "d i _ _ _ _ _ r"
        }
      },
      "reponse": "dénominateur",
      "propositions": [
        "dénominateur",
        "numérateur",
        "quotient",
        "diviseur"
      ],
      "correction": "Le dénominateur est le nombre situé sous la barre de fraction.\nIl indique en combien de parts égales l’unité est partagée."
    },
