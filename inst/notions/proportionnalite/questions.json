    {
      "id": "PROP-002",
      "type": "qcm",
      "enonce": "Quel indice permet de reconnaître une situation de proportionnalité ?",
      "reponse": "Le quotient correspondant reste constant.",
      "propositions": [
        "Le quotient correspondant reste constant.",
        "On ajoute toujours le même nombre.",
        "Les deux grandeurs sont toujours égales.",
        "Le graphique est toujours horizontal."
      ],
      "correction": "Une proportionnalité se caractérise par un coefficient multiplicatif constant."
    },
    {
      "id": "PROP-003",
      "type": "qcm",
      "enonce": "Dans un tableau de proportionnalité, que représente le coefficient de proportionnalité ?",
      "reponse": "Le nombre par lequel on multiplie une grandeur pour obtenir l’autre.",
      "propositions": [
        "Le nombre par lequel on multiplie une grandeur pour obtenir l’autre.",
        "La somme des deux grandeurs.",
        "La différence entre deux colonnes.",
        "Le plus grand nombre du tableau."
      ],
      "correction": "Le coefficient relie les valeurs correspondantes par une multiplication."
