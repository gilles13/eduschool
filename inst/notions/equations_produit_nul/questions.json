      "propositions": [
        "𝑥 = [[a]] ou 𝑥 = [[b]]",
        "𝑥 = [[a]]",
        "𝑥 = [[b]]",
        "𝑥 = [[a_plus_1]] ou 𝑥 = [[b_plus_1]]"
      ],
