{
  "notion_id": "decimaux_droite_graduee",
  "questions": [
    {
      "id": "DROITE_GRADUEE_DECIMAUX-001",
      "type": "qcm",
      "enonce": "Sur une droite dont chaque graduation vaut 0,1, quelle valeur suit immédiatement 4,7 ?",
      "reponse": {
        "mode": "editoriale",
        "valeur": "4,8"
      },
      "propositions": [
        "4,8",
        "4,71",
        "5,7",
        "4,07"
      ],
      "correction": "Une graduation ajoute un dixième."
    },
    {
      "id": "DROITE_GRADUEE_DECIMAUX-002",
      "type": "qcm",
      "enonce": "Un point est situé à cinq dixièmes après 2. Quelle est son abscisse ?",
      "reponse": {
        "mode": "editoriale",
        "valeur": "2,5"
      },
      "propositions": [
        "2,5",
        "2,05",
        "7",
        "2,005"
      ],
      "correction": "Cinq dixièmes après 2 donnent 2,5."
    },
    {
      "id": "DROITE_GRADUEE_DECIMAUX-003",
      "type": "qcm",
      "enonce": "Entre 1 et 2, on place 100 intervalles égaux. Quelle valeur représente un intervalle ?",
      "reponse": {
        "mode": "editoriale",
        "valeur": "0,01"
      },
      "propositions": [
        "0,01",
        "0,1",
        "0,001",
        "1"
      ],
      "correction": "Une unité partagée en cent intervalles donne un centième."
    },
    {
      "id": "DROITE_GRADUEE_DECIMAUX-004",
      "type": "qcm",
      "enonce": "Sur une droite graduée de 0,2 en 0,2, quel nombre suit 3,4 ?",
      "reponse": {
        "mode": "editoriale",
        "valeur": "3,6"
      },
      "propositions": [
        "3,6",
        "3,5",
        "3,42",
        "3,8"
      ],
      "correction": "Ajouter 0,2 à 3,4 donne 3,6."
    },
    {
