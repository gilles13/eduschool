flowchart TD
  MOD["Modification des données ou du code"] --> LOAD["devtools::load_all()"]
  LOAD --> DATA["Contrôles de cohérence des référentiels"]
  DATA --> TEST["devtools::test()"]
  TEST --> OK{"Tests réussis ?"}
  OK -- Non --> FIX["Corriger"]
  FIX --> LOAD
  OK -- Oui --> CHECK["devtools::check()"]
  CHECK --> COK{"Check réussi ?"}
  COK -- Non --> FIX
  COK -- Oui --> DOC["pkgdown::build_site() si nécessaire"]
  DOC --> COMMIT["Commit / push"]
