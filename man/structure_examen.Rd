\name{structure_examen}
\alias{structure_examen}
\title{Structure d'un examen}
\usage{structure_examen(code, session)}
\arguments{\item{code}{Code de l'examen.}\item{session}{Session de l'examen.}}
\value{Une liste contenant l'examen, ses parties, profils et concepts.}
\description{Expose les contraintes officielles et les profils pedagogiques utilises pour la composition.}
